# Configurações do FreeRTOS 
CONFIG_FREERTOS_USE_TRACE_FACILITY=y
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y
CONFIG_FREERTOS_HZ=1000

# Habilita o suporte à RAM externa
CONFIG_SPIRAM=y

# Inicializa a PSRAM automaticamente durante o boot
CONFIG_SPIRAM_BOOT_INIT=y

# Força o modo Octal
CONFIG_SPIRAM_MODE_OCT=y

# configura o nucleo como 240Mhz
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ=240
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

CONFIG_COMPILER_CXX_EXCEPTIONS=y

# Default (3584) is too small for ROBOT::init() (SD card, settings, WiFi/
# ESP-NOW/OTA bring-up, motors, encoders), which all run on this task's
# stack before any FreeRTOS task with its own stack takes over.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# Native USB Mass Storage used to expose the SD card in DEBUG state.
CONFIG_TINYUSB_MSC_ENABLED=y
CONFIG_TINYUSB_MSC_BUFSIZE=8192
CONFIG_TINYUSB_MSC_MOUNT_PATH="/sdcard"
CONFIG_TINYUSB_DESC_PRODUCT_STRING="BallyRobot"
CONFIG_TINYUSB_DESC_MSC_STRING="BallyRobot SD Card"

# Automatic rollback if a newly OTA-flashed image never confirms itself healthy
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# T33 (TAREFAS_TCP_BLE_ANDROID.txt, ETAPA 4): NimBLE, not Bluedroid -- this
# robot only ever needs a BLE peripheral role (rule for every task in the
# plan: "BLE do ESP32-S3: não incluir Bluetooth clássico/SPP"), and NimBLE is
# the smaller-footprint, BLE-only host stack ESP-IDF ships for exactly that
# case (components/bt/Kconfig: "recommended for BLE only usecases to save on
# memory"). The ESP32-S3 radio itself is BLE-only anyway (no classic BT
# hardware), so this also can't regress into dual-mode by accident.
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
# The whole direct-BLE receive path runs ON the nimble_host task: the GATT
# write handler feeds the COBS decoder, btp::Node answers HELLO inline
# (session + endpoint framing + COBS encode) and notifies from there. The
# 4096 default overflowed on the very first HELLO_RESULT.
CONFIG_BT_NIMBLE_HOST_TASK_STACK_SIZE=8192
# INFO logs two lines per notification ("GATT procedure initiated: notify")
# to the UART, from the nimble_host task itself -- at telemetry rates that
# is real time stolen from the BLE link.
CONFIG_BT_NIMBLE_LOG_LEVEL_WARNING=y
